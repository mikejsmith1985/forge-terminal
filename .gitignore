# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# Cross-compiled release binaries built into the repo root (extension-less, so
# the *.exe rule above misses them). These are release artifacts — they belong
# in bin/ and on the GitHub Release/R2, never committed. Leaving stale copies in
# the root once caused a release to ship the wrong (old) binary.
/forge-linux-amd64
/forge-darwin-amd64
/forge-darwin-arm64
/forge-windows-amd64.exe
/forge

# Windows resource files (generated)
*.syso

# Go
*.test
*.out

# Node
node_modules/
frontend/node_modules/
.pnpm-store/

# Build artifacts
frontend/dist/
web/assets/
cmd/forge/web/index.html
# cmd/forge/web/companion/ is intentionally tracked so //go:embed all:web always
# includes the companion PWA files. The pre-commit hook exempts cmd/forge/web/
# from the test-file gate so releases don't generate false-positive violations.

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
*.log

# Handshake document (auto-generated)
FORGE_HANDSHAKE.md

# Issue images (downloaded for debugging)
issue-images/

# AM logs (local session data)
.forge/

# Copilot session documentation (temporary)
docs/sessions/

# Test artifacts
frontend/test-results/

# Build binary
/forge

# Tool configurations — personal settings ignored, shared commands tracked in .claude/commands/
.claude/settings.json
.claude/settings.local.json
.claude/*.json
.claude/todos.md

# Backup and temp files
*.bak
*.old
*.broken
*.backup
*~

# Debug/proof artifacts (should never be committed)
*.diff
*.pid
*.txt.tmp

# Temporary documentation and status files
PR_DESCRIPTION*.md
*_SUMMARY.md
*_STATUS.md
*_INDEX.md
*_CHECKLIST.md
*_COMPLETE.md
*_READY.md
*_LOG.md
*_KICKOFF.md
*_FIXES.md
*_START.md
*_GUIDE.md
*_PLAN.md
*_RESULTS.md
*_VERIFICATION.md
VERIFICATION_*.md
*_CHARTER.md

# Detailed changelogs (keep locally, not customer-facing)
RELEASE_NOTES_*.md
RELEASE_SUMMARY_*.md
CHANGELOG_*.md
V*.md
v*.md
# Re-include shared Claude skill files — the v*.md rule above would otherwise
# block vault-operations.md and any future skill whose name starts with 'v'.
!.claude/commands/*.md
*_RELEASE_*.md
*_FIX_*.md
*_VALIDATION*.md
*_DASHBOARD*.html
*-dashboard*.html
*-validation*.html

# Logs and monitoring
logs/
scripts/freeze-monitor/
perfmon-data.csv
MIKESDELL_*/

# Temporary files
nul

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
